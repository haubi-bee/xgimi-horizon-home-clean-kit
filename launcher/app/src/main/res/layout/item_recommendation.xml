<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/rec_card_width"
    android:layout_height="@dimen/rec_card_height"
    android:layout_marginEnd="@dimen/card_spacing"
    android:background="@drawable/card_background"
    android:focusable="true"
    android:foreground="@drawable/card_focus_frame">

    <ImageView
        android:id="@+id/recommendation_poster"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />
</FrameLayout>

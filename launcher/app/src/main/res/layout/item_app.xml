<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/app_card_width"
    android:layout_height="@dimen/app_card_height"
    android:layout_marginEnd="@dimen/card_spacing"
    android:background="@drawable/card_background"
    android:focusable="true"
    android:foreground="@drawable/card_focus_frame">

    <ImageView
        android:id="@+id/app_banner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Custom name of a renamed tile that has a banner. -->
    <TextView
        android:id="@+id/app_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/caption_background"
        android:ellipsize="end"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:paddingTop="@dimen/app_caption_padding"
        android:paddingBottom="@dimen/app_caption_padding"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/app_caption_size"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/app_fallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="@dimen/app_icon_size"
            android:layout_height="@dimen/app_icon_size"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/app_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/app_label_size" />
    </LinearLayout>
</FrameLayout>
